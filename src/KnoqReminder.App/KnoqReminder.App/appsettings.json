{
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "ColorBehavior": "Enabled"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Knoq": {
    "BaseUrl": {
      "Api": "https://knoq.trap.jp/api/",
      "WebPage": "https://knoq.trap.jp/"
    }
  },
  "Traq": {
    "BaseUrl": {
      "Api": "https://q.trap.jp/api/v3/"
    }
  },
  "Discord": {
    "Webhooks": {
      "BaseUrl": "https://discord.com/api/webhooks/"
    }
  },
  "Localization": {
    "default": {
      "culture": "ja-JP",
      "timeZone": "Asia/Tokyo"
    }
  },
  "Reminder": {
    "FirstDelay": "00:00:10",
    "TaskTimeout": "00:01:00"
  }
}
